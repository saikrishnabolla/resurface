{
  "name": "resurface-transcriptions",
  "productName": "Resurface Transcriptions",
  "version": "1.0.0",
  "description": "Local YouTube channel transcript archive with full-text search",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:python": "cd python && .venv/bin/pyinstaller --noconfirm --clean --onedir --name extractor --distpath ../build/python --workpath ../build/pyinstaller-work --specpath ../build --collect-submodules yt_dlp extractor.py",
    "setup:python": "cd python && uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r requirements.txt",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build:python && npm run build && electron-builder --mac dir && rm -rf \"$HOME/Applications/Resurface Transcriptions.app\" && cp -R \"dist/mac-arm64/Resurface Transcriptions.app\" \"$HOME/Applications/\""
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
