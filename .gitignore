# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/
__pycache__/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache
.cache
.eslintcache
.turbo
.swc

# Local pipeline data and generated media
transcripts/
transcripts.jsonl
recs.json
tool-results/
*.mp4
*.mov
!public/demo/**/*.mp4
!examples/*/runs/*/clips/*.mp4
!examples/*/runs/*/clips/*.mov
!examples/*/runs/*/videos/*.mp4
